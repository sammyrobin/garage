# Photos only. Nothing in here is ever executed.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pl .py .cgi .sh
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
SetHandler none

# Only processed WebP images may be served.
<FilesMatch "\.(?!webp$)[^.]+$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'"
    Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
